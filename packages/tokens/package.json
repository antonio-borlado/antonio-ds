    "./css/*": "./dist/css/*",
    "./json/*": "./dist/json/*",
    "./ds-theme.js": "./dist/ds-theme.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
