{
  "name": "@antonio-ds/tokens",
  "version": "1.0.0",
  "description": "Design tokens and multi-brand themes (CSS variables, JS, JSON)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonio-borlado/antonio-ds.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/antonio-borlado/antonio-ds#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
