{
  "name": "@antonio-ds/components",
  "version": "2.0.0",
  "description": "Framework-agnostic Web Components (Lit) themed by @antonio-ds/tokens",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonio-borlado/antonio-ds.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/antonio-borlado/antonio-ds#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/generated/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./cdn": "./dist/cdn/ds-components.js",
    "./REFERENCE.md": "./dist/REFERENCE.md",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build-icons.mjs && vite build && vite build --mode cdn && tsc -p tsconfig.json --emitDeclarationOnly && custom-elements-manifest analyze --litelement --globs \"src/components/*.ts\" --outdir dist --quiet && node scripts/build-reference.mjs",
    "export:svg": "node scripts/export-svgs.mjs"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "@antonio-ds/tokens": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@material-symbols/svg-400": "^0.48.0",
    "heroicons": "^2.2.0",
    "lucide-static": "^1.55.0",
    "svgo": "^4.1.0",
    "vite": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "dist/custom-elements.json"
}
