{
  "name": "@antonio-ds/components",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Components (Lit) themed by @antonio-ds/tokens",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "default": "./dist/index.js" },
    "./cdn": "./dist/cdn/ds-components.js"
  },
  "sideEffects": true,
  "scripts": {
    "build": "vite build && vite build --mode cdn && tsc -p tsconfig.json --emitDeclarationOnly"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "@antonio-ds/tokens": "^0.1.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "publishConfig": { "access": "public" }
}
